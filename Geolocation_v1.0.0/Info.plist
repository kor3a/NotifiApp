	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.kor3a.nearbuy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Opened from the email-verification web page (nearbuyallim.com/verify)
				     via allim://login to bring the user back to the Login screen. -->
				<string>allim</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>GoogleSignIn</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- REVERSED_CLIENT_ID from GoogleService-Info.plist; receives the
				     Google Sign-In OAuth callback. -->
				<string>com.googleusercontent.apps.903190692128-h6gt4jvvnqvk791o2nndnnuurprgl0tc</string>
			</array>
		</dict>
	</array>
	<!-- Publishable token only — safe to embed; used to build img.logo.dev image URLs.
	     The Logo.dev SECRET key is NOT shipped in the app: Brand Search now goes
	     through the `logoBrandSearch` Cloud Function, which holds the secret. -->
	<key>LOGO_DEV_TOKEN</key>
	<string>$(LOGO_DEV_TOKEN)</string>
	<!-- Queried by NavigationLauncher to see which map apps are installed before
	     handing off directions from the "Go" notification action. canOpenURL always
	     answers false for a scheme that isn't listed here. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>maps</string>
		<string>comgooglemaps</string>
		<string>waze</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>We need your location to notify you when you&apos;re near stores with pending reminders, even when the app is in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We need your location to show nearby stores and notify you when you&apos;re near stores with pending reminders.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Allim uses the microphone when you tap the record button on a store so you can add, check off, or remove reminders by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Allim turns what you say into text so it can understand voice commands like &quot;add milk&quot; or &quot;check off bread&quot;. You always confirm before anything changes.</string>
	<key>NSSiriUsageDescription</key>
	<string>NearBuy uses Siri to let you send and receive messages about your shopping reminders hands-free while driving.</string>
	<key>NSUserActivityTypes</key>
	<array>
