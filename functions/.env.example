# Copy this file to `.env` (same folder) and fill in your values.
# Firebase automatically loads functions/.env into process.env at deploy time.
# `.env` itself is git-ignored; this `.env.example` is committed as a template.

# Sender address for the verification email.
# MUST be on a domain you've verified in Resend (https://resend.com/domains).
# While unset, the function falls back to "onboarding@resend.dev", which Resend
# only delivers to your own Resend account email — fine for testing, not for users.
VERIFICATION_FROM_EMAIL="Allim <noreply@yourdomain.com>"
