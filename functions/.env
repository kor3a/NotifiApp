# Loaded into process.env by Firebase at deploy time (firebase deploy --only functions).
# Sender for the verification email — must be on the verified Resend domain.
VERIFICATION_FROM_EMAIL="Allim <noreply@nearbuyallim.com>"

# Dedicated sender for in-app "Report & Feedback" submissions (submitFeedback).
# MUST be on a domain you've verified in Resend. Falls back to onboarding@resend.dev.
FEEDBACK_FROM_EMAIL="Allim Feedback <feedback@nearbuyallim.com>"

# Inbox that receives user reports & feedback. Defaults to jjamesubongdev@gmail.com.
FEEDBACK_TO_EMAIL="jjamesubongdev@gmail.com"