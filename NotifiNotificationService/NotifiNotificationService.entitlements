<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Communication Notifications capability (com.apple.developer.usernotifications.communication)
	     lives on the APP target only — it is not a valid entitlement for an
	     extension's provisioning profile. The extension still produces
	     communication notifications via INSendMessageIntent because the host app
	     holds the capability. -->
	<!-- Shared app group, kept in parity with the app and the widget so the
	     extension can read shared data if needed later. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kor3a.nearbuy</string>
	</array>
</dict>
</plist>
