rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection rules
    match /users/{userId} {
      // Allow authenticated users to read any user document
      // This is needed during signup to check if username is already taken
      // AND during profile load to query user by email
      // Note: User creates auth account first, then checks username availability
      // IMPORTANT: Email queries require a Firestore index on the 'email' field
      allow read: if request.auth != null;

      // Allow authenticated users to create user documents
      allow create: if request.auth != null;

      // Allow users to update/delete only their own document
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Stores collection rules (add as needed)
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Reminders collection rules
    match /reminders/{reminderId} {
      // Allow authenticated users to read/write reminders
      // Reminders are linked to user_stores via userStoreId field
      // Query by userStoreId requires a Firestore index on 'userStoreId' field
      allow read: if request.auth != null;

      // Allow creating reminders with required userStoreId field
      allow create: if request.auth != null &&
                       request.resource.data.userStoreId is string &&
                       request.resource.data.title is string &&
                       request.resource.data.isDone is bool;

      // Allow updating/deleting reminders
      allow update, delete: if request.auth != null;
    }

    // User-Store associations
    match /user_stores/{userStoreId} {
      // Allow users to read their own user_stores documents
      // Query by userId requires a Firestore index on 'userId' field
      allow read: if request.auth != null;

      // Allow users to create user_stores documents
      allow create: if request.auth != null &&
                       request.resource.data.userId is string;

      // Allow users to delete their own user_stores
      // The userId field stores the full email address
      allow delete: if request.auth != null &&
                       resource.data.userId == request.auth.token.email;
    }
  }
}
