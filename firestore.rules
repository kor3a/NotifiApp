rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection rules
    match /users/{userId} {
      // Allow authenticated users to read any user document
      // This is needed during signup to check if username is already taken
      // AND during profile load to query user by email
      // Note: User creates auth account first, then checks username availability
      // IMPORTANT: Email queries require a Firestore index on the 'email' field
      allow read: if request.auth != null;

      // Allow authenticated users to create user documents
      allow create: if request.auth != null;

      // Allow users to update/delete only their own document
      // Note: userId is the username (document ID), so we check against email instead
      allow update, delete: if request.auth != null &&
                               resource.data.email == request.auth.token.email;
    }

    // Stores collection rules (add as needed)
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Reminders collection rules
    match /reminders/{reminderId} {
      // Allow authenticated users to read reminders
      // Reminders are linked to user_stores via userStoreId field (which may be a sharedStoreGroupId)
      // Query by userStoreId requires a Firestore index on 'userStoreId' field
      allow read: if request.auth != null;

      // Allow creating reminders with required userStoreId field
      // Note: Permission enforcement is handled at application level
      allow create: if request.auth != null &&
                       request.resource.data.userStoreId is string &&
                       request.resource.data.title is string &&
                       request.resource.data.isDone is bool;

      // Allow updating/deleting reminders
      // Note: Permission enforcement is handled at application level
      allow update, delete: if request.auth != null;
    }

    // User-Store associations
    match /user_stores/{userStoreId} {
      // Allow users to read their own user_stores documents
      // Query by userId requires a Firestore index on 'userId' field
      allow read: if request.auth != null;

      // Allow users to create user_stores documents
      allow create: if request.auth != null &&
                       request.resource.data.userId is string &&
                       request.resource.data.userEmail is string;

      // Allow users to update their own user_stores (for sort order, permission updates)
      allow update: if request.auth != null &&
                       resource.data.userEmail == request.auth.token.email;

      // Allow users to delete their own user_stores
      // Also allow deletion of shared stores where the shared group no longer exists (cleanup)
      allow delete: if request.auth != null &&
                       (resource.data.userEmail == request.auth.token.email ||
                        (resource.data.sharedStoreGroupId != null &&
                         !exists(/databases/$(database)/documents/shared_store_groups/$(resource.data.sharedStoreGroupId))));
    }

    // Shared Store Groups collection
    match /shared_store_groups/{groupId} {
      // Allow authenticated users to read shared store groups
      allow read: if request.auth != null;

      // Allow creating shared store groups
      allow create: if request.auth != null &&
                       request.resource.data.storeId is string &&
                       request.resource.data.userStoreIds is list;

      // Allow updating shared store groups (for adding/removing members)
      allow update: if request.auth != null;

      // Allow deleting shared store groups when deleting stores
      allow delete: if request.auth != null;
    }
  }
}
