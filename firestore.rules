rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection rules
    match /users/{userId} {
      // Allow authenticated users to read any user document
      // This is needed during signup to check if username is already taken
      // AND during profile load to query user by email
      // Note: User creates auth account first, then checks username availability
      // IMPORTANT: Email queries require a Firestore index on the 'email' field
      allow read: if request.auth != null;

      // Allow authenticated users to create user documents
      allow create: if request.auth != null;

      // Allow users to update/delete only their own document
      // Note: userId is the username (document ID), so we check against email instead
      allow update, delete: if request.auth != null &&
                               resource.data.email == request.auth.token.email;
    }

    // Stores collection rules (add as needed)
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Reminders collection rules
    match /reminders/{reminderId} {
      // Allow authenticated users to read reminders
      // Reminders are linked to user_stores via userStoreId field (which may be a sharedStoreGroupId)
      // Query by userStoreId requires a Firestore index on 'userStoreId' field
      allow read: if request.auth != null;

      // Helper function to check if user has permission to modify reminders
      function hasEditPermission(userStoreId) {
        // Check if user has a user_store with edit or owner permission
        return exists(/databases/$(database)/documents/user_stores/$(userStoreId)) &&
               get(/databases/$(database)/documents/user_stores/$(userStoreId)).data.userEmail == request.auth.token.email &&
               get(/databases/$(database)/documents/user_stores/$(userStoreId)).data.permission in ['owner', 'edit'];
      }

      function hasSharedGroupPermission(sharedGroupId) {
        // For shared groups, check if any user_store with this sharedStoreGroupId belongs to the user with edit permission
        let userStores = firestore.get(/databases/$(database)/documents/user_stores).data;
        return userStores.exists(us => us.sharedStoreGroupId == sharedGroupId &&
                                      us.userEmail == request.auth.token.email &&
                                      us.permission in ['owner', 'edit']);
      }

      // Allow creating reminders with required fields
      // User must have edit permission for the userStoreId (or sharedStoreGroupId)
      allow create: if request.auth != null &&
                       request.resource.data.userStoreId is string &&
                       request.resource.data.title is string &&
                       request.resource.data.isDone is bool;

      // Allow updating/deleting reminders only if user has edit permission
      allow update, delete: if request.auth != null;
    }

    // User-Store associations
    match /user_stores/{userStoreId} {
      // Helper function to check if user is a co-owner in a shared group
      function isCoOwner(sharedGroupId) {
        // Check if the shared group exists and contains the user's email in any user_store
        return sharedGroupId != null &&
               exists(/databases/$(database)/documents/shared_store_groups/$(sharedGroupId));
      }

      // Allow users to read their own user_stores documents
      // Query by userId requires a Firestore index on 'userId' field
      allow read: if request.auth != null;

      // Allow users to create user_stores documents
      allow create: if request.auth != null &&
                       request.resource.data.userId is string &&
                       request.resource.data.userEmail is string;

      // Allow users to update their own user_stores (for sort order, permission updates)
      allow update: if request.auth != null &&
                       resource.data.userEmail == request.auth.token.email;

      // Allow users to delete their own user_stores
      // OR allow deletion if user is a co-owner in a shared group (for synced deletions)
      // Note: Application logic ensures only co-owners can trigger shared deletions
      allow delete: if request.auth != null &&
                       (resource.data.userEmail == request.auth.token.email ||
                        (resource.data.permission == 'edit' &&
                         isCoOwner(resource.data.sharedStoreGroupId)));
    }

    // Shared Store Groups collection
    match /shared_store_groups/{groupId} {
      // Allow authenticated users to read shared store groups
      allow read: if request.auth != null;

      // Allow creating shared store groups
      allow create: if request.auth != null &&
                       request.resource.data.storeId is string &&
                       request.resource.data.userStoreIds is list;

      // Allow updating shared store groups (for adding/removing members)
      allow update: if request.auth != null;

      // Allow deleting shared store groups when deleting stores
      allow delete: if request.auth != null;
    }
  }
}
