// ============================================================================
// firestore.rules.pending  —  STRICT read-privacy rules (NOT YET DEPLOYED)
// ============================================================================
//
// This is the hardened successor to firestore.rules. It closes the remaining
// read-privacy gaps for the messaging feature: only conversation participants
// can read a conversation and its messages, and only participants can update or
// delete them. Membership is verified via a `participantEmails` array on each
// conversation document.
//
// DO NOT DEPLOY THIS FILE UNTIL ALL of the following are true, or messaging
// WILL BREAK for users on older builds:
//   1. The app build that writes `participantEmails` on conversation create /
//      member add / member remove is live AND adopted by ~all active users
//      (MessagingService.resolveParticipantEmails).
//   2. The one-time backfill has been run so existing conversations carry
//      `participantEmails`:
//         Functions.functions().httpsCallable("backfillMessagingIdentity")()
//      (run once from the owner account; safe to re-run).
//   3. The app build that writes `senderEmail` on on_my_way_notifications /
//      reminder_change_notifications is live AND adopted by ~all active users
//      (this file REQUIRES senderEmail on create; older builds omit it and
//      would fail to send those notifications).
//
// To deploy, point firebase.json's firestore.rules at this file (or copy its
// contents over firestore.rules) and `firebase deploy --only firestore:rules`.
//
// STILL OPEN after this file (see SECURITY_REMEDIATION.md):
//   - reminders: read/write remain broad because the shared-store model keys
//     reminders by the OWNER's user_store id. Needs an ownerEmail/editorEmails
//     field on reminders (app change) before rules can enforce it.
//   (on_my_way_notifications / reminder_change_notifications sender spoofing is
//   closed by this file: create requires senderEmail == auth email — see
//   deploy precondition 3 above.)
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================

    // Check if the current user owns the given user_store document
    function isUserStoreOwner(userStoreId) {
      return exists(/databases/$(database)/documents/user_stores/$(userStoreId)) &&
             get(/databases/$(database)/documents/user_stores/$(userStoreId)).data.userEmail == request.auth.token.email;
    }

    // Check if the given ID refers to an existing shared store group.
    // For shared "Can Edit" stores, reminders use the sharedStoreGroupId
    // as their userStoreId. All group members may read/write these reminders.
    // NOTE: This verifies the group exists but cannot verify membership
    // without iterating userStoreIds (not supported in rules). To enforce
    // membership, consider adding a memberEmails array to shared_store_groups.
    function isSharedStoreGroup(groupId) {
      return exists(/databases/$(database)/documents/shared_store_groups/$(groupId));
    }

    // ============================================================
    // Users Collection
    // ============================================================
    match /users/{userId} {
      // Allow authenticated users to read any user document.
      // Required for: username availability checks during signup,
      // user profile lookups by email, friend search by username.
      // NOTE: To restrict further, consider limiting list queries via
      // query-based rules once the app supports it.
      // Index required: email (ascending)
      allow read: if request.auth != null;

      // Allow creating a user document only if the email matches
      // the authenticated user. Prevents creating docs with another
      // user's email address.
      allow create: if request.auth != null &&
                       request.resource.data.email is string &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.name is string &&
                       request.resource.data.userId is string;

      // Allow users to update/delete only their own document.
      // Ownership verified via email since document ID is the username.
      allow update, delete: if request.auth != null &&
                               resource.data.email == request.auth.token.email;
    }

    // ============================================================
    // Recipes Collection (custom user-defined recipes)
    // ============================================================
    match /recipes/{recipeId} {
      // Allow any authenticated user to query — the app always filters
      // by userId so only the owner's recipes are returned.
      // This mirrors the pattern used by reminders and user_stores.
      allow read: if request.auth != null;

      // Only the owner can create a recipe (userEmail must match auth)
      allow create: if request.auth != null &&
                       request.resource.data.userId is string &&
                       request.resource.data.userEmail is string &&
                       request.resource.data.name is string &&
                       request.resource.data.ingredients is list &&
                       request.resource.data.userEmail == request.auth.token.email;

      // Only the owner can update or delete
      allow update, delete: if request.auth != null &&
                                resource.data.userEmail == request.auth.token.email;
    }

    // ============================================================
    // Stores Collection (global catalog)
    // ============================================================
    // This is a GLOBAL, shared catalog: every document is visible to and
    // affects every user. The app only ever READS this collection
    // (StoresViewModel), so client writes are locked to the app owner to
    // prevent any authenticated user from vandalising or wiping the catalog
    // for everyone. Seeding/maintenance is done by the owner or via the
    // Admin SDK (which bypasses these rules).
    match /stores/{storeId} {
      // Any authenticated user can read the store catalog
      allow read: if request.auth != null;

      // Only the app owner may mutate shared catalog entries.
      allow create, update: if request.auth != null &&
                               request.auth.token.email == "kor3a5@gmail.com" &&
                               request.resource.data.name is string;

      allow delete: if request.auth != null &&
                       request.auth.token.email == "kor3a5@gmail.com";
    }

    // ============================================================
    // Reminders Collection
    // ============================================================
    match /reminders/{reminderId} {
      // Allow authenticated users to read reminders.
      // Reminders are queried by userStoreId which can resolve to:
      //   - The user's own user_store ID (personal stores)
      //   - A sharedStoreGroupId (legacy shared "Can Edit" stores)
      //   - The owner's user_store ID via sourceUserStoreId (shared stores)
      // The sourceUserStoreId case prevents email-based ownership checks
      // since the user_store belongs to the owner, not the recipient.
      allow read: if request.auth != null;

      // Allow creating reminders with required fields.
      // Ownership cannot be fully verified in rules because shared store
      // recipients create reminders using the owner's user_store ID
      // (via sourceUserStoreId). Permission enforcement (owner/edit/view)
      // is handled at the application level.
      allow create: if request.auth != null &&
                       request.resource.data.userStoreId is string &&
                       request.resource.data.title is string &&
                       request.resource.data.isDone is bool;

      // Allow updating/deleting reminders.
      // Same limitation as create: shared store recipients reference the
      // owner's user_store ID, so rules cannot verify edit permission.
      allow update, delete: if request.auth != null;
    }

    // ============================================================
    // Store Logos (logo URL cache for store icons)
    // ============================================================
    match /stores_logos/{logoId} {
      // Any authenticated user can read store logos
      allow read: if request.auth != null;

      // Global, shared catalog — a logo here is shown to every user who has that
      // store. The app only READS it (uploadStoreLogo/deleteStoreLogo are
      // owner/admin seed tools, never called from the app UI), so writes are
      // locked to the app owner to stop direct-to-Firestore logo vandalism.
      allow create, update: if request.auth != null &&
                               request.auth.token.email == "kor3a5@gmail.com" &&
                               request.resource.data.logoURL is string;

      allow delete: if request.auth != null &&
                       request.auth.token.email == "kor3a5@gmail.com";
    }

    // ============================================================
    // Store Websites (shared store -> website URL overrides)
    // ============================================================
    match /store_websites/{doc} {
      // Any authenticated user can read website overrides (used to build
      // the "Visit store" link). Consistent with the rest of this file.
      allow read: if request.auth != null;

      // Only the app owner may add/edit/delete overrides, since each
      // document applies for every user who has that store.
      allow create, update: if request.auth != null &&
                               request.auth.token.email == "kor3a5@gmail.com" &&
                               request.resource.data.websiteURL is string;
      allow delete: if request.auth != null &&
                       request.auth.token.email == "kor3a5@gmail.com";
    }

    // ============================================================
    // Favorite Tags (persistent, reusable reminder shortcuts)
    // ============================================================
    match /favorite_tags/{tagId} {
      // Allow users to read only their own favorite tags.
      // Ownership verified by matching userId (app username) to email via the
      // users collection, since userId is the app username and not the Auth UID.
      allow read: if request.auth != null &&
                     get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email;

      // Allow creating favorite tags only for the authenticated user.
      allow create: if request.auth != null &&
                       request.resource.data.userStoreId is string &&
                       request.resource.data.userId is string &&
                       request.resource.data.title is string &&
                       request.resource.data.createdAt is number &&
                       get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.email == request.auth.token.email;

      // Allow updating/deleting only the user's own favorite tags.
      allow update, delete: if request.auth != null &&
                               get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email;
    }

    // ============================================================
    // User-Store Associations
    // ============================================================
    match /user_stores/{userStoreId} {
      // Allow authenticated users to read user_store documents.
      // The owner may need to look up shared user_stores (e.g., to
      // unshare), so reads cannot be restricted to own email only.
      // Index required: userId (ascending)
      allow read: if request.auth != null;

      // Allow creating user_stores only if userEmail matches the
      // authenticated user. Prevents creating store associations
      // for other users.
      allow create: if request.auth != null &&
                       request.resource.data.userId is string &&
                       request.resource.data.userEmail is string &&
                       request.resource.data.userEmail == request.auth.token.email;

      // Allow users to update their own user_stores.
      // Also allow:
      // - Any user to update only the sharedWith/isSharedStore fields (recipient
      //   cleans up the owner's sharing metadata when they leave a shared store).
      // - The original sharer to update the recipient's user_store in order to
      //   clear sharing metadata on their side (e.g. when the owner deletes their
      //   store or explicitly unshares — mirrors the existing allow-delete rule).
      allow update: if request.auth != null &&
                       (resource.data.userEmail == request.auth.token.email ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'isSharedStore']) ||
                        resource.data.sharedFromEmail == request.auth.token.email ||
                        (resource.data.sharedFrom != null &&
                         get(/databases/$(database)/documents/users/$(resource.data.sharedFrom)).data.email == request.auth.token.email));

      // Allow deletion by:
      // 1. The owner of the user_store (userEmail matches)
      // 2. Orphaned shared stores (shared group no longer exists)
      // 3. The original sharer via sharedFromEmail
      // 4. The original sharer via sharedFrom userId lookup
      allow delete: if request.auth != null &&
                       (resource.data.userEmail == request.auth.token.email ||
                        (resource.data.sharedStoreGroupId != null &&
                         !exists(/databases/$(database)/documents/shared_store_groups/$(resource.data.sharedStoreGroupId))) ||
                        resource.data.sharedFromEmail == request.auth.token.email ||
                        (resource.data.sharedFrom != null &&
                         get(/databases/$(database)/documents/users/$(resource.data.sharedFrom)).data.email == request.auth.token.email));
    }

    // ============================================================
    // Shared Store Groups
    // ============================================================
    match /shared_store_groups/{groupId} {
      // Allow authenticated users to read shared store groups
      allow read: if request.auth != null;

      // Allow creating shared store groups with required fields.
      // The creator's userStoreId must be first in the array, and
      // the creator must own that user_store.
      allow create: if request.auth != null &&
                       request.resource.data.storeId is string &&
                       request.resource.data.userStoreIds is list &&
                       request.resource.data.userStoreIds.size() > 0 &&
                       isUserStoreOwner(request.resource.data.userStoreIds[0]);

      // Allow updating only by the group owner (first userStoreId).
      allow update: if request.auth != null &&
                       resource.data.userStoreIds.size() > 0 &&
                       isUserStoreOwner(resource.data.userStoreIds[0]);

      // Allow deleting only by the group owner (first userStoreId).
      allow delete: if request.auth != null &&
                       resource.data.userStoreIds.size() > 0 &&
                       isUserStoreOwner(resource.data.userStoreIds[0]);
    }

    // ============================================================
    // Conversations (messaging feature — 1:1 and group)
    // ============================================================
    // Membership is verified via participantEmails (written by the app and
    // backfilled onto legacy docs). Only participants may read/update/delete.
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
                     resource.data.participantEmails is list &&
                     request.auth.token.email in resource.data.participantEmails;

      // 1:1 conversations require exactly 2 participants.
      // Group conversations (isGroup == true) require 2 or more participants.
      // The creator must include themselves in participantEmails.
      allow create: if request.auth != null &&
                       request.resource.data.participantIds is list &&
                       request.resource.data.participantEmails is list &&
                       request.auth.token.email in request.resource.data.participantEmails &&
                       (
                         request.resource.data.participantIds.size() == 2 ||
                         (request.resource.data.isGroup == true &&
                          request.resource.data.participantIds.size() >= 2 &&
                          request.resource.data.groupName is string)
                       );

      // Only a current participant may update (send updates last-message /
      // unread counts, add/remove members). The updater must remain (or, for
      // member changes, the caller must be a participant before the change).
      allow update: if request.auth != null &&
                       request.auth.token.email in resource.data.participantEmails;

      allow delete: if request.auth != null &&
                       request.auth.token.email in resource.data.participantEmails;
    }

    // ============================================================
    // Messages (messaging feature)
    // ============================================================
    // A message belongs to a conversation; access is gated on membership of the
    // parent conversation (via its participantEmails). Each read/write does one
    // get() on the parent conversation — acceptable for the app's page sizes.
    match /messages/{messageId} {
      function callerInConversation(convId) {
        return exists(/databases/$(database)/documents/conversations/$(convId)) &&
               request.auth.token.email in
                 get(/databases/$(database)/documents/conversations/$(convId)).data.participantEmails;
      }

      allow read: if request.auth != null &&
                     callerInConversation(resource.data.conversationId);

      // Sender must be the authenticated user (username->email lookup) AND a
      // member of the target conversation.
      allow create: if request.auth != null &&
                       request.resource.data.conversationId is string &&
                       request.resource.data.senderId is string &&
                       request.resource.data.content is string &&
                       get(/databases/$(database)/documents/users/$(request.resource.data.senderId)).data.email == request.auth.token.email &&
                       callerInConversation(request.resource.data.conversationId);

      // Participants may update (mark read) / delete within their conversation.
      allow update: if request.auth != null &&
                       callerInConversation(resource.data.conversationId);

      allow delete: if request.auth != null &&
                       callerInConversation(resource.data.conversationId);
    }

    // ============================================================
    // Friends
    // ============================================================
    match /friends/{friendshipId} {
      // Allow authenticated users to read friendships.
      // The app queries by participantIds (usernames), which can't be
      // matched against auth email in rules. Write rules still enforce
      // ownership via email checks below.
      allow read: if request.auth != null;

      // Only the requester can create a friendship document
      allow create: if request.auth != null &&
                       request.resource.data.requesterId is string &&
                       request.resource.data.receiverId is string &&
                       request.resource.data.participantIds is list &&
                       request.resource.data.status is string &&
                       request.resource.data.requesterEmail == request.auth.token.email;

      // Only participants can update (accept/reject)
      allow update: if request.auth != null &&
                       (resource.data.requesterEmail == request.auth.token.email ||
                        resource.data.receiverEmail == request.auth.token.email);

      // Only participants can delete (unfriend/cancel)
      allow delete: if request.auth != null &&
                       (resource.data.requesterEmail == request.auth.token.email ||
                        resource.data.receiverEmail == request.auth.token.email);
    }

    // ============================================================
    // Reminder Change Notifications (shared store updates)
    // ============================================================
    match /reminder_change_notifications/{notificationId} {
      // Only the recipient can read their own notifications (matched by email)
      allow read: if request.auth != null &&
                     resource.data.recipientEmail == request.auth.token.email;

      // Any authenticated user can create a notification for another user,
      // but must identify themselves: senderEmail is REQUIRED here and must
      // match the caller's auth email, so pushes can't be spoofed. Only
      // deploy once the build that writes senderEmail is adopted.
      allow create: if request.auth != null &&
                       request.resource.data.recipientEmail is string &&
                       request.resource.data.senderName is string &&
                       request.resource.data.storeName is string &&
                       request.resource.data.createdAt is number &&
                       request.resource.data.senderEmail == request.auth.token.email;

      // Only the recipient can delete (after consuming the notification)
      allow delete: if request.auth != null &&
                       resource.data.recipientEmail == request.auth.token.email;
    }

    // ============================================================
    // Friend Requests
    // ============================================================
    match /friend_requests/{requestId} {
      // Allow authenticated users to read friend requests.
      // The app queries by fromUserId/toUserId (usernames), which can't
      // be matched against auth email in rules. Write rules still enforce
      // ownership via email checks below.
      allow read: if request.auth != null;

      // Only the sender can create a friend request
      allow create: if request.auth != null &&
                       request.resource.data.fromUserId is string &&
                       request.resource.data.toUserId is string &&
                       request.resource.data.status is string &&
                       request.resource.data.fromUserEmail == request.auth.token.email;

      // Only participants can update (accept/reject)
      allow update: if request.auth != null &&
                       (resource.data.fromUserEmail == request.auth.token.email ||
                        resource.data.toUserEmail == request.auth.token.email);

      // Only participants can delete
      allow delete: if request.auth != null &&
                       (resource.data.fromUserEmail == request.auth.token.email ||
                        resource.data.toUserEmail == request.auth.token.email);
    }

    // ============================================================
    // On My Way Notifications (shared store travel alerts)
    // ============================================================
    match /on_my_way_notifications/{notificationId} {
      // Only the recipient can read their own notifications (matched by email)
      allow read: if request.auth != null &&
                     resource.data.recipientEmail == request.auth.token.email;

      // Any authenticated user can create a notification for another user,
      // but must identify themselves: senderEmail is REQUIRED here and must
      // match the caller's auth email, so pushes can't be spoofed. Only
      // deploy once the build that writes senderEmail is adopted.
      allow create: if request.auth != null &&
                       request.resource.data.recipientEmail is string &&
                       request.resource.data.senderName is string &&
                       request.resource.data.storeName is string &&
                       request.resource.data.travelTimeMinutes is int &&
                       request.resource.data.createdAt is number &&
                       request.resource.data.senderEmail == request.auth.token.email;

      // Only the recipient can delete (after consuming the notification)
      allow delete: if request.auth != null &&
                       resource.data.recipientEmail == request.auth.token.email;
    }
  }
}
