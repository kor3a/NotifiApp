// Secrets.xcconfig.template
// Copy this file to Secrets.xcconfig and fill in your API keys.
// Secrets.xcconfig is excluded from git via .gitignore.

// OPENAI_API_KEY is no longer read by the app — Smart Recipe / Smart Category
// now call the `openAIChat` Cloud Function, which holds the key server-side.
// Set it with:  firebase functions:secrets:set OPENAI_API_KEY

// LOGO_DEV_TOKEN is a PUBLISHABLE token (safe to embed; used only in image URLs).
LOGO_DEV_TOKEN = YOUR_LOGO_DEV_PUBLISHABLE_TOKEN_HERE
// LOGO_DEV_SECRET_KEY is no longer read by the app — Brand Search now calls the
// `logoBrandSearch` Cloud Function, which holds the secret server-side.
// Set it with:  firebase functions:secrets:set LOGO_DEV_SECRET_KEY
