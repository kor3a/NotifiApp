// Secrets.xcconfig.template
// Copy this file to Secrets.xcconfig and fill in your API keys.
// Secrets.xcconfig is excluded from git via .gitignore.

OPENAI_API_KEY = YOUR_OPENAI_API_KEY_HERE
LOGO_DEV_TOKEN = YOUR_LOGO_DEV_PUBLISHABLE_TOKEN_HERE
LOGO_DEV_SECRET_KEY = YOUR_LOGO_DEV_SECRET_KEY_HERE

// Mapbox public access token (pk.xxxx) read at runtime by the Mapbox map.
// See MAPBOX_SETUP.md for how to create this and the separate secret
// downloads token (sk.xxxx) needed to install the SDK via Swift Package Manager.
MAPBOX_ACCESS_TOKEN = YOUR_MAPBOX_PUBLIC_ACCESS_TOKEN_HERE
